{
  "name": "tokenhandler",
  "version": "1.0.0",
  "description": "An AWS serverless token handler with low cost hosting for my blog's Final SPA",
  "author": "Gary Archer",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "rm -rf dist && NODE_OPTIONS='--import tsx' npx rollup --config build/rollup.config.ts",
    "deployDev": "./deploy.sh dev",
    "deploy": "./deploy.sh deployed",
    "removeDev": "sls remove --stage dev",
    "remove": "sls remove --stage deployed"
  },
  "dependencies": {
    "@middy/core": "^7.9.2",
    "cookie": "^1.1.1",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "serverless": "^4.42.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "workspaces": [
    "build"
  ]
}
